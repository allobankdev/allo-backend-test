@startuml
title Allo Bank Backend Flow: Startup Load and Request Handling

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 120

actor Client
participant "Spring Boot" as Spring
participant "StartupDataLoader\n(ApplicationRunner)" as Runner
participant "IDRDataFetcher\nStrategies" as Strategies
participant "FrankfurterClient" as ApiClient
participant "Frankfurter API" as ExternalApi
participant "InMemoryFinanceDataStore" as Store
participant "FinanceDataController" as Controller
participant "DefaultFinanceDataService" as Service
participant "GlobalExceptionHandler" as ErrorHandler

== Application Startup ==

Spring -> Runner: run()
Runner -> Strategies: fetch() for each resourceType

loop latest_idr_rates, historical_idr_usd, supported_currencies
    Strategies -> ApiClient: request external data
    ApiClient -> ExternalApi: GET resource
    ExternalApi --> ApiClient: JSON response
    ApiClient --> Strategies: mapped DTO / map
    Strategies --> Runner: List<FinanceDataItem>
end

Runner -> Store: replaceAll(immutable data map)
Store --> Runner: data stored

== API Request Flow ==

Client -> Controller: GET /api/finance/data/{resourceType}
Controller -> Service: getByResourceType(resourceType)

alt resourceType unsupported
    Service -> Service: validate resourceType
    Service -> ErrorHandler: ResourceTypeNotFoundException
    ErrorHandler --> Client: 404 ErrorResponse
else resourceType supported
    Service -> Store: getByResourceType(resourceType)

    alt data not initialized
        Store -> ErrorHandler: DataNotInitializedException
        ErrorHandler --> Client: 502 ErrorResponse
    else data available
        Store --> Service: List<FinanceDataItem>
        Service --> Controller: List<FinanceDataItem>
        Controller --> Client: 200 JSON array
    end
end

note over Runner,Store
All external API calls happen once during startup.
Endpoint requests read only from in-memory store.
end note

note over Service
Strategy map is used for resource validation/routing.
No if/else or switch is needed in controller.
end note

@enduml
